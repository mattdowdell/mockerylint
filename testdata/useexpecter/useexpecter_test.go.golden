package useexpecter

import (
	"testing"

	"github.com/stretchr/testify/mock"
)


func TestExample_Good(t *testing.T) {
	m := NewMockExample(t)
	m.EXPECT().Example(1).Return(1).Once()

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

func TestExample_Bad(t *testing.T) {
	m := NewMockExample(t)
	m.EXPECT().Example(1).Return(1).Once() // want `use .EXPECT instead of .On`

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

func TestExample_BadEmbedded(t *testing.T) {
	m := NewMockExample(t)
	m.EXPECT().Example(1).Return(1).Once() // want `use .EXPECT instead of .On`

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

// TestExample_BadConstName names the mocked method with a constant, which testify resolves
// to the same method, so the rewrite does too.
func TestExample_BadConstName(t *testing.T) {
	const name = "Example"

	m := NewMockExample(t)
	m.EXPECT().Example(1).Return(1).Once() // want `use .EXPECT instead of .On`

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

// TestExample_BadPromoted chains only methods promoted from the embedded *mock.Call, which
// the expecter leaves alone, so the rewrite is unaffected by them.
func TestExample_BadPromoted(t *testing.T) {
	m := NewMockExample(t)
	m.EXPECT().Example(1).Times(2).Return(1) // want `use .EXPECT instead of .On`

	got := m.Example(1) + m.Example(1)

	if got != 2 {
		t.Fail()
	}
}

// TestExample_BadNoFixDynamicReturn passes .Return the function that computes the return
// value, which the expecter spells as .RunAndReturn, so there is no rewrite to offer.
func TestExample_BadNoFixDynamicReturn(t *testing.T) {
	m := NewMockExample(t)
	m.On("Example", 1).Return(func(n int) int { return n }).Once() // want `use .EXPECT instead of .On`

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

// TestExample_BadNoFixRun passes .Run the untyped arguments of testify, where the expecter
// passes the arguments of the mocked method, so there is no rewrite to offer.
func TestExample_BadNoFixRun(t *testing.T) {
	m := NewMockExample(t)
	m.On("Example", 1).Run(func(args mock.Arguments) {}).Return(1).Once() // want `use .EXPECT instead of .On`

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

// TestExample_BadNoFixEscapes holds the expectation in a variable typed as testify's
// *mock.Call, which the expecter form is not, so there is no rewrite to offer.
func TestExample_BadNoFixEscapes(t *testing.T) {
	m := NewMockExample(t)

	c := m.On("Example", 1) // want `use .EXPECT instead of .On`
	c.Return(1).Once()

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

// TestExample_BadNoFixUnknownName names a method the expecter does not have, as a rename of
// the mocked interface leaves behind, so there is no rewrite to offer.
func TestExample_BadNoFixUnknownName(t *testing.T) {
	m := NewMockExample(t)
	m.On("Removed", 1).Return(1).Maybe() // want `use .EXPECT instead of .On`
}

// TestExample_BadNoFixArgCount matches fewer arguments than the mocked method takes, which
// the expecter method does not allow, so there is no rewrite to offer.
func TestExample_BadNoFixArgCount(t *testing.T) {
	m := NewMockExample(t)
	m.On("Example").Return(1).Maybe() // want `use .EXPECT instead of .On`
}

// TestExample_BadNoFixVarName names the mocked method with a value known only at run time,
// so there is no name to rewrite the selector with.
func TestExample_BadNoFixVarName(t *testing.T) {
	name := "Example"

	m := NewMockExample(t)
	m.On(name, 1).Return(1).Once() // want `use .EXPECT instead of .On`

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

// TestLegacy_Good uses .On because the mock was generated without with-expecter, so it
// has no expecter to use instead.
func TestLegacy_Good(t *testing.T) {
	m := NewMockLegacy(t)
	m.On("Example", 1).Return(1).Once()

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}

// TestLegacy_GoodEmbedded is TestLegacy_Good written against the embedded testify mock.
func TestLegacy_GoodEmbedded(t *testing.T) {
	m := NewMockLegacy(t)
	m.Mock.On("Example", 1).Return(1).Once()

	got := m.Example(1)

	if got != 1 {
		t.Fail()
	}
}
